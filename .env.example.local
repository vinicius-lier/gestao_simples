DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-dev-only
DB_ENGINE=sqlite
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# HTTPS: manter desativado enquanto o acesso for HTTP.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Integracoes opcionais: preencher apenas no .env, nunca versionar credenciais.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_ACESSO=acesso_portal
WHATSAPP_TEMPLATE_COBRANCA=cobranca_mensalidade
