DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-dev-only
DB_ENGINE=sqlite
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# HTTPS: manter desativado enquanto o acesso for HTTP.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Integracoes opcionais: preencher apenas no .env, nunca versionar credenciais.
# Local: sempre o sandbox da Woovi (não movimenta dinheiro real).
WOOVI_BASE_URL=https://api.woovi-sandbox.com
WOOVI_APP_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_ACESSO=acesso_portal
WHATSAPP_TEMPLATE_COBRANCA=cobranca_mensalidade

# Evolution API local (opcional): docker compose --profile evolution up -d
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://127.0.0.1:8080
# Gere valores aleatórios próprios (o compose recusa subir com eles vazios):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_AUTHENTICATION_API_KEY=
EVOLUTION_DB_PASSWORD=
# O Django fala com a Evolution local com a mesma chave acima.
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_TIMEOUT=15
EVOLUTION_WEBHOOK_TOKEN=
