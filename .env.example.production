# Variáveis da aplicação no Coolify (aba Environment Variables), marcadas só
# como Runtime — nenhuma precisa de Buildtime. Passo a passo em deploy/COOLIFY.md.
# Os segredos ficam só no Coolify: aqui vão apenas os nomes.

# Django
DJANGO_DEBUG=false
# Mínimo 50 caracteres: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# O domínio + 127.0.0.1 e localhost (o HEALTHCHECK do Dockerfile chama /health/ por eles).
ALLOWED_HOSTS=SEU_DOMINIO,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://SEU_DOMINIO
# Base dos links enviados pelo WhatsApp (lembretes, acesso ao portal).
SITE_URL=https://SEU_DOMINIO
# Com HTTPS: true. Enquanto o acesso for só por HTTP, false (senão o login falha).
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# O proxy do Coolify já força HTTPS; true quebraria o health check interno.
SECURE_SSL_REDIRECT=false
# Suba para 31536000 depois que o HTTPS estiver estável.
SECURE_HSTS_SECONDS=0
WEB_CONCURRENCY=2

# Banco: PostgreSQL do Coolify. Copie da "Postgres URL (internal)" do banco:
# postgres://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/POSTGRES_DB
DB_ENGINE=postgresql
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Só o host (nome do contêiner do banco), nunca a URL inteira.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Pix via Woovi. Comece pelo sandbox: https://api.woovi-sandbox.com
WOOVI_BASE_URL=https://api.woovi.com
WOOVI_APP_ID=

# WhatsApp: serviço Evolution API do Coolify. EVOLUTION_BASE_URL recebe o
# SERVICE_URL_EVO do serviço; EVOLUTION_API_KEY, o
# SERVICE_PASSWORD_AUTHENTICATIONAPIKEY do serviço.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_TIMEOUT=15
# Opcional: webhook de status da conexão (/webhooks/evolution/<instancia>/).
EVOLUTION_WEBHOOK_TOKEN=

# Monitoramento: alertas num canal do Discord (erros 500, alertas da
# plataforma, RAM/disco da VPS). Canal > Integrações > Webhooks > Copiar URL.
ALERTAS_DISCORD_WEBHOOK_URL=
# Limites (%) do comando verificar_servidor.
# MONITORAMENTO_LIMITE_RAM=90
# MONITORAMENTO_LIMITE_DISCO=85

# Assinatura do sistema (Configurações > Minha assinatura): chave Pix onde as
# academias pagam a mensalidade do sistema. Nome até 25 e cidade até 15
# caracteres. Chave: CPF/CNPJ só números, e-mail, +55DDDNUMERO ou aleatória.
PLATAFORMA_PIX_CHAVE=
PLATAFORMA_PIX_NOME=
PLATAFORMA_PIX_CIDADE=
