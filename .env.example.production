# Substitua SEU_HOST pelo IP publico ou dominio da EC2.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME
DB_ENGINE=postgresql
ALLOWED_HOSTS=SEU_HOST,localhost,127.0.0.1
POSTGRES_DB=academia_gestao
POSTGRES_USER=academia_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=60
SITE_URL=http://SEU_HOST

# HTTPS: manter desativado enquanto o acesso for HTTP.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Integracoes opcionais: preencher apenas no .env, nunca versionar credenciais.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_ACESSO=acesso_portal
WHATSAPP_TEMPLATE_COBRANCA=cobranca_mensalidade

# WhatsApp via Evolution API (profile "evolution" do compose.yaml).
# Passos completos em deploy/EVOLUTION.md.
EVOLUTION_IMAGE=atendai/evolution-api:v2.1.1
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://127.0.0.1:8080
EVOLUTION_AUTHENTICATION_API_KEY=CHANGE_ME
EVOLUTION_DB_PASSWORD=CHANGE_ME
EVOLUTION_LOG_LEVEL=ERROR
EVOLUTION_TIMEOUT=15
# Sem token o webhook /webhooks/evolution/ recusa eventos (503) em produção.
EVOLUTION_WEBHOOK_TOKEN=CHANGE_ME
# Uma variável por academia; o nome vai em IntegracaoWhatsApp.credencial_ref.
# O valor deve ser igual a EVOLUTION_AUTHENTICATION_API_KEY (ou a apikey da
# instância devolvida na criação).
# EVOLUTION_API_KEY_KEIKO=CHANGE_ME
