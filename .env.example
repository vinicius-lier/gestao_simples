# Django: preencha uma chave aleatoria exclusiva antes de iniciar.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Copie este arquivo para ".env" (já está no .gitignore) e preencha com
# suas credenciais. Sem essas variáveis, o botão "Gerar Pix" do painel
# financeiro falha com uma mensagem amigável — é o comportamento esperado,
# não um bug.

# Painel do Asaas > Integrações > Chave de API.
# Sandbox (ambiente de testes, não movimenta dinheiro real):
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Produção:
# ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=

# Painel do Asaas > Integrações > Webhooks > token de autenticação.
# Exigido no cabeçalho "asaas-access-token" de POST /webhooks/asaas/.
# Sem isso definido, o endpoint aceita qualquer chamada — use vazio só
# em desenvolvimento local.
ASAAS_WEBHOOK_TOKEN=

# WhatsApp Cloud API (Meta). Sem essas variáveis, o envio automático de
# mensagens (acesso ao portal do responsável, aviso de cobrança) fica
# indisponível e o sistema cai no link manual (wa.me) para o operador
# enviar — não é obrigatório para o resto do sistema funcionar.
# Meta Business Manager > seu app > WhatsApp > Configuração da API.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Nomes dos templates aprovados no Meta Business Manager (Business
# Manager > WhatsApp Manager > Modelos de mensagem). Precisam existir e
# estar aprovados antes de usar; os nomes abaixo são só o padrão.
# acesso_portal: variáveis {{1}} nome do responsável, {{2}} link de acesso
WHATSAPP_TEMPLATE_ACESSO=acesso_portal
# cobranca_mensalidade: {{1}} nome, {{2}} competência, {{3}} valor,
# {{4}} vencimento, {{5}} link de pagamento
WHATSAPP_TEMPLATE_COBRANCA=cobranca_mensalidade

# Base para montar links absolutos fora de uma request — usado pelo
# comando enviar_lembretes_cobranca (agendado por cron/Agendador de
# Tarefas, sem uma request HTTP disponível). Em produção, use o domínio
# real com https.
SITE_URL=http://127.0.0.1:8000
# Banco: use postgresql para conectar ao servidor; sqlite mantém a base local.
DB_ENGINE=postgresql
POSTGRES_DB=gestao_simples
POSTGRES_USER=gestao_simples
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Local: prefer. Em produção, configure conforme o provedor (ex.: verify-full).
POSTGRES_SSLMODE=prefer
# Mantenha 0 para ASGI; em WSGI pode usar 60.
DB_CONN_MAX_AGE=0
