# Exemplos completos: .env.example.local e .env.example.production.
# Django: preencha uma chave aleatoria exclusiva antes de iniciar.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Produção (Coolify): em ALLOWED_HOSTS, o domínio + 127.0.0.1 e localhost (o
# HEALTHCHECK do Dockerfile chama /health/ por eles). Aqui, o domínio com https.
CSRF_TRUSTED_ORIGINS=
# HTTPS — só valem com DJANGO_DEBUG=false. No Coolify, ligue os cookies
# seguros; mantenha SECURE_SSL_REDIRECT=false (o proxy já força HTTPS e o
# redirecionamento quebraria o health check interno).
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Gunicorn no Dockerfile: número de workers (padrão 2).
# WEB_CONCURRENCY=2

# Copie este arquivo para ".env" (já está no .gitignore) e preencha com
# suas credenciais. Sem essas variáveis, o botão "Gerar Pix" do painel
# financeiro falha com uma mensagem amigável — é o comportamento esperado,
# não um bug.

# Pix via Woovi (produção). Painel da Woovi > API/Plugins > Nova API: copie o
# AppID. Para testar sem dinheiro real, use o sandbox:
#   WOOVI_BASE_URL=https://api.woovi-sandbox.com (conta em app.woovi-sandbox.com)
WOOVI_BASE_URL=https://api.woovi.com
WOOVI_APP_ID=
# Opcional: menor saque aceito pela Woovi, em centavos (padrão 101 = R$ 1,01).
# WOOVI_SAQUE_MINIMO_CENTAVOS=101
# Opcional: tarifa de saque (padrão 100 = R$ 1,00, paga pela academia) e a
# partir de quanto o saque não tem tarifa (padrão 100000 = R$ 1.000,00).
# WOOVI_TARIFA_SAQUE_CENTAVOS=100
# WOOVI_SAQUE_SEM_TARIFA_CENTAVOS=100000
# Opcional: timeout das chamadas à Woovi (segundos) e cache das chaves que
# assinam o webhook (segundos).
# WOOVI_TIMEOUT=30
# WOOVI_WEBHOOK_CHAVES_TTL=21600
# Webhook: POST /webhooks/woovi/ com os eventos OPENPIX:CHARGE_COMPLETED,
# OPENPIX:MOVEMENT_CONFIRMED e OPENPIX:MOVEMENT_FAILED. A autenticidade é
# conferida pelo header x-webhook-signature — não há segredo a configurar.

# WhatsApp Cloud API (Meta). Sem essas variáveis, o envio automático de
# mensagens (acesso ao portal do responsável, aviso de cobrança) fica
# indisponível e o sistema cai no link manual (wa.me) para o operador
# enviar — não é obrigatório para o resto do sistema funcionar.
# Meta Business Manager > seu app > WhatsApp > Configuração da API.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Nomes dos templates aprovados no Meta Business Manager (Business
# Manager > WhatsApp Manager > Modelos de mensagem). Precisam existir e
# estar aprovados antes de usar; os nomes abaixo são só o padrão.
# acesso_portal: variáveis {{1}} nome do responsável, {{2}} link de acesso
WHATSAPP_TEMPLATE_ACESSO=acesso_portal
# cobranca_mensalidade: {{1}} nome, {{2}} competência, {{3}} valor,
# {{4}} vencimento, {{5}} link de pagamento
WHATSAPP_TEMPLATE_COBRANCA=cobranca_mensalidade

# Base para montar links absolutos fora de uma request — usado pelo
# comando enviar_lembretes_cobranca (agendado por cron/Agendador de
# Tarefas, sem uma request HTTP disponível). Em produção, use o domínio
# real com https.
SITE_URL=http://127.0.0.1:8000
# Banco: use postgresql para conectar ao servidor; sqlite mantém a base local.
DB_ENGINE=postgresql
POSTGRES_DB=gestao_simples
POSTGRES_USER=gestao_simples
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Local: prefer. Em produção, configure conforme o provedor (ex.: verify-full).
POSTGRES_SSLMODE=prefer
# Mantenha 0 para ASGI; em WSGI pode usar 60.
DB_CONN_MAX_AGE=0

# n8n (contrato preparado, ainda inativo — não ligue nesta fase).
N8N_WEBHOOK_URL=
N8N_TOKEN=
N8N_TIMEOUT=10
# Fase 2 dos lembretes (desligadas): gerar o Pix antes do lembrete e enviar
# pelo n8n em vez do provedor de WhatsApp.
# LEMBRETES_GERAM_COBRANCA_PIX=false
# LEMBRETES_ENVIAM_N8N=false

# Evolution API — servidor (compose, profile "evolution").
# Sobe com: docker compose --profile evolution up -d
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_PORT=8080
# URL pública/base pela qual a Evolution se enxerga (mesma que o app usa em
# evolution_base_url). Em servidor único: http://127.0.0.1:8080
EVOLUTION_SERVER_URL=http://127.0.0.1:8080
# Chave global da Evolution (gere uma aleatória forte). É o valor que cada
# EVOLUTION_API_KEY_<ACADEMIA> abaixo precisa conter.
EVOLUTION_AUTHENTICATION_API_KEY=
# Senha do Postgres dedicado da Evolution (container evolution_db).
EVOLUTION_DB_PASSWORD=
EVOLUTION_LOG_LEVEL=ERROR

# Evolution API — aplicação (Django).
EVOLUTION_TIMEOUT=15
# Botões nas mensagens (desligado: o WhatsApp descartou mensagens com botão).
# EVOLUTION_BOTOES=false
# Webhook opcional de eventos de conexão (connection.update / qrcode.updated).
# Em produção, sem este token o endpoint recusa eventos (503).
EVOLUTION_WEBHOOK_TOKEN=

# Monitoramento: alertas num canal do Discord (erros 500, alertas da
# plataforma, RAM/disco da VPS). Canal > Integrações > Webhooks > Copiar URL.
ALERTAS_DISCORD_WEBHOOK_URL=
# Limites (%) do comando verificar_servidor.
# MONITORAMENTO_LIMITE_RAM=90
# MONITORAMENTO_LIMITE_DISCO=85

# Assinatura do sistema (Configurações > Minha assinatura): chave Pix onde as
# academias pagam a mensalidade do sistema. Nome até 25 e cidade até 15
# caracteres. Chave: CPF/CNPJ só números, e-mail, +55DDDNUMERO ou aleatória.
PLATAFORMA_PIX_CHAVE=
PLATAFORMA_PIX_NOME=
PLATAFORMA_PIX_CIDADE=
# Servidor Evolution da plataforma: a academia só informa o número e lê o QR
# Code em Configurações > WhatsApp. EVOLUTION_API_KEY é a
# AUTHENTICATION_API_KEY do servidor Evolution.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
# Opcional, pelo admin: uma academia pode usar outro servidor/chave
# (evolution_base_url e credencial_ref = NOME de outra variável, ex.:
# EVOLUTION_API_KEY_KEIKO).
